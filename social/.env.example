# Copiar este archivo como social/.env y completar. El .env real NO se sube a git.

# Meta for Developers → tu app → Configuración → Básica
META_APP_ID=
META_APP_SECRET=

# Token corto del Graph API Explorer. Solo se usa una vez, con "node social/cli.mjs setup", y después se puede borrar.
META_USER_TOKEN=

# Los completa "setup" solo. FB_PAGE_ID se puede poner a mano si el token ve más de una página.
FB_PAGE_ID=
IG_USER_ID=
META_PAGE_TOKEN=

# Opcionales
SITE_URL=https://thecrowfilm.com
GRAPH_VERSION=v23.0
