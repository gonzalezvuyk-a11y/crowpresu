{
  "meta": {
    "name": "The Crow Design Tokens",
    "version": "1.2.0",
    "layers": ["tokens", "semantic", "components"]
  },
  "fonts": [
    {
      "family": "TT Norms Pro Trial",
      "src": "./assets/fonts/TT_Norms_Pro_Trial_Regular.ttf",
      "weight": 400,
      "style": "normal"
    },
    {
      "family": "TT Norms Pro Mono Trl",
      "src": "./assets/fonts/TT_Norms_Pro_Mono_Trial_Regular.ttf",
      "weight": 400,
      "style": "normal"
    },
    {
      "family": "TT Norms Pro Mono Trl",
      "src": "./assets/fonts/TT_Norms_Pro_Mono_Trial_DemiBold.ttf",
      "weight": 600,
      "style": "normal"
    }
  ],
  "tokens": {
    "color": {
      "ink": "#0d0d0d",
      "muted": "#8a8a8a",
      "rule-soft": "rgba(13, 13, 13, 0.12)",
      "rule-strong": "rgba(13, 13, 13, 0.15)",
      "border-soft": "rgba(13, 13, 13, 0.13)",
      "surface-document": "#fcfcfb",
      "surface-app": "#eceae6",
      "surface-panel": "#f5f4f1",
      "surface-card": "rgba(255, 255, 255, 0.45)",
      "inverse": "#fcfcfb"
    },
    "font-family": {
      "body": "\"TT Norms Pro Trial\", \"Helvetica Neue\", Arial, sans-serif",
      "mono": "\"TT Norms Pro Mono Trl\", \"SFMono-Regular\", Consolas, monospace"
    },
    "space": {
      "1": "1px",
      "2": "2px",
      "3": "3px",
      "4": "4px",
      "5": "5px",
      "6": "6px",
      "7": "7px",
      "8": "8px",
      "9": "9px",
      "10": "10px",
      "11": "11px",
      "12": "12px",
      "13": "13px",
      "14": "14px",
      "15": "15px",
      "16": "16px",
      "18": "18px",
      "22": "22px",
      "24": "24px",
      "28": "28px",
      "32": "32px",
      "36": "36px",
      "40": "40px",
      "50": "50px",
      "52": "52px",
      "60": "60px",
      "80": "80px",
      "108": "108px"
    },
    "radius": {
      "xs": "1px",
      "sm": "2px"
    },
    "font-size": {
      "micro": "6px",
      "micro-plus": "6.5px",
      "tiny": "7px",
      "small": "7.5px",
      "label": "8px",
      "ui": "8.5px",
      "body": "10px",
      "field": "10.5px",
      "input": "11px",
      "button": "9px",
      "price": "16px",
      "display": "32px"
    },
    "tracking": {
      "wide": "0.04em",
      "ui": "0.06em",
      "label": "0.08em",
      "meta": "0.1em",
      "strong": "0.12em",
      "heading": "0.14em",
      "title": "0.16em",
      "section": "0.2em",
      "brand-ui": "0.22em",
      "brand-doc": "0.26em"
    },
    "line": {
      "body": "1.5",
      "relaxed": "1.6",
      "doc": "1.85"
    }
  },
  "semantic": {
    "color": {
      "text": {
        "primary": "{tokens.color.ink}",
        "muted": "{tokens.color.muted}",
        "inverse": "{tokens.color.inverse}"
      },
      "surface": {
        "document": "{tokens.color.surface-document}",
        "app": "{tokens.color.surface-app}",
        "panel": "{tokens.color.surface-panel}",
        "card": "{tokens.color.surface-card}"
      },
      "border": {
        "default": "{tokens.color.border-soft}",
        "emphasis": "{tokens.color.rule-strong}"
      },
      "rule": {
        "soft": "{tokens.color.rule-soft}",
        "strong": "{tokens.color.rule-strong}"
      }
    },
    "typography": {
      "brand": {
        "ui-tracking": "{tokens.tracking.brand-ui}",
        "document-tracking": "{tokens.tracking.brand-doc}"
      },
      "eyebrow": {
        "size": "{tokens.font-size.ui}",
        "tracking": "{tokens.tracking.section}"
      },
      "body": {
        "size": "{tokens.font-size.body}",
        "line": "{tokens.line.body}",
        "document-line": "{tokens.line.doc}"
      },
      "input": {
        "size": "{tokens.font-size.input}",
        "line": "{tokens.line.relaxed}"
      }
    },
    "layout": {
      "panel": {
        "section-block": "{tokens.space.18}",
        "section-inline": "{tokens.space.22}"
      },
      "document": {
        "padding": "{tokens.space.52}"
      }
    }
  },
  "components": {
    "button": {
      "primary": {
        "foreground": "{semantic.color.text.inverse}",
        "background": "{semantic.color.text.primary}",
        "padding-y": "{tokens.space.8}",
        "padding-x": "{tokens.space.14}",
        "radius": "{tokens.radius.sm}"
      },
      "secondary": {
        "foreground": "{semantic.color.text.muted}",
        "background": "transparent",
        "border": "{semantic.color.border.default}",
        "padding-y": "{tokens.space.8}",
        "margin-top": "{tokens.space.9}",
        "radius": "{tokens.radius.sm}"
      }
    },
    "field": {
      "label": {
        "foreground": "{semantic.color.text.muted}",
        "margin-bottom": "{tokens.space.4}"
      },
      "input": {
        "foreground": "{semantic.color.text.primary}",
        "border": "{semantic.color.border.default}",
        "padding-top": "{tokens.space.4}",
        "padding-bottom": "{tokens.space.6}"
      }
    },
    "chip": {
      "default": {
        "foreground": "{semantic.color.text.muted}",
        "border": "{semantic.color.border.default}",
        "radius": "{tokens.radius.sm}"
      },
      "active": {
        "foreground": "{semantic.color.text.inverse}",
        "background": "{semantic.color.text.primary}",
        "border": "{semantic.color.text.primary}"
      }
    },
    "card": {
      "surface": "{semantic.color.surface.card}",
      "border": "{semantic.color.border.default}",
      "radius": "{tokens.radius.sm}"
    },
    "document": {
      "sheet": {
        "background": "{semantic.color.surface.document}",
        "padding": "{semantic.layout.document.padding}"
      }
    }
  },
  "aliases": {
    "ink": "{semantic.color.text.primary}",
    "muted": "{semantic.color.text.muted}",
    "rule": "{semantic.color.rule.soft}",
    "border": "{semantic.color.border.default}",
    "bg": "{semantic.color.surface.document}",
    "bg-doc": "{semantic.color.surface.document}",
    "bg-app": "{semantic.color.surface.app}",
    "bg-b": "{semantic.color.surface.panel}",
    "font": "{tokens.font-family.body}",
    "font-mono": "{tokens.font-family.mono}",
    "m": "{semantic.layout.document.padding}",
    "doc-m": "{semantic.layout.document.padding}",
    "brand-logo-beige": "#cfb9a6",
    "brand-logo-color": "var(--brand-logo-beige)"
  },
  "rules": [
    {
      "selectors": ["*", "*::before", "*::after"],
      "declarations": {
        "box-sizing": "border-box",
        "margin": "0",
        "padding": "0"
      }
    },
    {
      "selectors": ["html", "body"],
      "declarations": {
        "font-family": "var(--font)",
        "-webkit-font-smoothing": "antialiased",
        "color": "{semantic.color.text.primary}"
      }
    },
    {
      "selectors": ["button", "input", "textarea", "select"],
      "declarations": {
        "font": "inherit"
      }
    },
    {
      "selectors": [".btop-brand"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "10px",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-brand-ui)",
        "color": "{semantic.color.text.primary}",
        "text-transform": "uppercase"
      }
    },
    {
      "selectors": [".brand-logo"],
      "declarations": {
        "display": "inline-block",
        "flex": "0 0 auto",
        "overflow": "hidden",
        "line-height": "0"
      }
    },
    {
      "selectors": [".brand-logo img"],
      "declarations": {
        "display": "block",
        "width": "100%",
        "height": "100%",
        "object-fit": "contain",
        "filter": "var(--brand-logo-filter, none)"
      }
    },
    {
      "selectors": [".brand-logo-wordmark"],
      "declarations": {
        "width": "96px",
        "height": "24px"
      }
    },
    {
      "selectors": [".brand-logo-ui-wordmark"],
      "declarations": {
        "width": "88px",
        "height": "24px"
      }
    },
    {
      "selectors": [".brand-logo-mark"],
      "declarations": {
        "width": "14px",
        "height": "17px"
      }
    },
    {
      "selectors": [".btn-export", ".ds-button-primary"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-button)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-heading)",
        "text-transform": "uppercase",
        "color": "{components.button.primary.foreground}",
        "background": "{components.button.primary.background}",
        "border": "none",
        "padding": "{components.button.primary.padding-y} {components.button.primary.padding-x}",
        "cursor": "pointer",
        "border-radius": "{components.button.primary.radius}",
        "transition": "opacity 120ms"
      }
    },
    {
      "selectors": [".btn-export:hover", ".ds-button-primary:hover"],
      "declarations": {
        "opacity": "0.7"
      }
    },
    {
      "selectors": [".btn-add", ".ds-button-secondary"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-button)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-strong)",
        "text-transform": "uppercase",
        "color": "{components.button.secondary.foreground}",
        "background": "{components.button.secondary.background}",
        "border": "1px solid {components.button.secondary.border}",
        "padding": "{components.button.secondary.padding-y} 0",
        "cursor": "pointer",
        "border-radius": "{components.button.secondary.radius}",
        "width": "100%",
        "margin-top": "{components.button.secondary.margin-top}",
        "transition": "all 100ms"
      }
    },
    {
      "selectors": [".btn-add:hover", ".ds-button-secondary:hover"],
      "declarations": {
        "color": "{semantic.color.text.primary}",
        "border-color": "{semantic.color.text.primary}"
      }
    },
    {
      "selectors": [".bsec", ".ds-panel-section"],
      "declarations": {
        "padding": "{semantic.layout.panel.section-block} {semantic.layout.panel.section-inline}",
        "border-bottom": "1px solid {semantic.color.border.default}"
      }
    },
    {
      "selectors": [".bsec-lbl", ".ds-eyebrow"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-ui)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-section)",
        "text-transform": "uppercase",
        "color": "{semantic.color.text.muted}",
        "margin-bottom": "var(--space-13)"
      }
    },
    {
      "selectors": [".sub-lbl"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-small)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-heading)",
        "text-transform": "uppercase",
        "color": "{semantic.color.text.muted}",
        "margin": "var(--space-13) 0 var(--space-8)"
      }
    },
    {
      "selectors": [".field"],
      "declarations": {
        "margin-bottom": "var(--space-12)"
      }
    },
    {
      "selectors": [".field:last-child"],
      "declarations": {
        "margin-bottom": "0"
      }
    },
    {
      "selectors": [".fl", ".ds-field-label"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "display": "block",
        "font-size": "var(--font-size-ui)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-strong)",
        "text-transform": "uppercase",
        "color": "{components.field.label.foreground}",
        "margin-bottom": "{components.field.label.margin-bottom}"
      }
    },
    {
      "selectors": [".fi", ".ft", ".fs", ".ds-input", ".ds-textarea", ".ds-select"],
      "declarations": {
        "width": "100%",
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-input)",
        "color": "{components.field.input.foreground}",
        "background": "transparent",
        "border": "none",
        "border-bottom": "1px solid {components.field.input.border}",
        "padding": "{components.field.input.padding-top} 0 {components.field.input.padding-bottom}",
        "outline": "none",
        "border-radius": "0",
        "-webkit-appearance": "none",
        "transition": "border-color 100ms"
      }
    },
    {
      "selectors": [".fi:focus", ".ft:focus", ".fs:focus", ".ds-input:focus", ".ds-textarea:focus", ".ds-select:focus"],
      "declarations": {
        "border-bottom-color": "{semantic.color.text.primary}"
      }
    },
    {
      "selectors": [".ft", ".ds-textarea"],
      "declarations": {
        "resize": "none",
        "line-height": "var(--line-relaxed)"
      }
    },
    {
      "selectors": [".fs", ".ds-select"],
      "declarations": {
        "cursor": "pointer"
      }
    },
    {
      "selectors": [".tipo-btn", ".chip", ".ds-chip"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-ui)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-strong)",
        "text-transform": "uppercase",
        "color": "{components.chip.default.foreground}",
        "background": "transparent",
        "border": "1px solid {components.chip.default.border}",
        "cursor": "pointer",
        "border-radius": "{components.chip.default.radius}",
        "transition": "all 100ms",
        "text-align": "center"
      }
    },
    {
      "selectors": [".tipo-btn"],
      "declarations": {
        "padding": "var(--space-8) var(--space-4)"
      }
    },
    {
      "selectors": [".chip", ".ds-chip"],
      "declarations": {
        "padding": "var(--space-5) var(--space-9)",
        "white-space": "nowrap",
        "letter-spacing": "var(--tracking-meta)"
      }
    },
    {
      "selectors": [".tipo-btn:hover", ".chip:hover", ".ds-chip:hover"],
      "declarations": {
        "color": "{semantic.color.text.primary}",
        "border-color": "{semantic.color.border.emphasis}"
      }
    },
    {
      "selectors": [".tipo-btn.on", ".chip.on", ".ds-chip.is-active"],
      "declarations": {
        "color": "{components.chip.active.foreground}",
        "background": "{components.chip.active.background}",
        "border-color": "{components.chip.active.border}"
      }
    },
    {
      "selectors": [".preset-row"],
      "declarations": {
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "var(--space-5)",
        "margin-bottom": "var(--space-12)"
      }
    },
    {
      "selectors": [".pchip", ".ds-chip-dashed"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-ui)",
        "letter-spacing": "var(--tracking-ui)",
        "color": "{components.chip.default.foreground}",
        "background": "transparent",
        "border": "1px dashed {components.chip.default.border}",
        "padding": "var(--space-4) var(--space-9)",
        "cursor": "pointer",
        "border-radius": "{components.chip.default.radius}",
        "transition": "all 100ms"
      }
    },
    {
      "selectors": [".pchip:hover", ".ds-chip-dashed:hover"],
      "declarations": {
        "color": "{semantic.color.text.primary}",
        "border-color": "{semantic.color.text.primary}",
        "border-style": "solid"
      }
    },
    {
      "selectors": [".chip-row"],
      "declarations": {
        "display": "flex",
        "flex-wrap": "wrap",
        "gap": "var(--space-5)"
      }
    },
    {
      "selectors": [".item-list"],
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "var(--space-9)"
      }
    },
    {
      "selectors": [".icard", ".ds-card"],
      "declarations": {
        "border": "1px solid {components.card.border}",
        "padding": "var(--space-11) var(--space-11) var(--space-9)",
        "background": "{components.card.surface}",
        "border-radius": "{components.card.radius}",
        "position": "relative"
      }
    },
    {
      "selectors": [".icard .field"],
      "declarations": {
        "margin-bottom": "var(--space-8)"
      }
    },
    {
      "selectors": [".icard .field:last-of-type"],
      "declarations": {
        "margin-bottom": "0"
      }
    },
    {
      "selectors": [".ibtn-x", ".obs-x"],
      "declarations": {
        "font-size": "16px",
        "line-height": "1",
        "color": "var(--muted)",
        "background": "none",
        "border": "none",
        "cursor": "pointer",
        "font-family": "var(--font-mono)",
        "transition": "color 100ms"
      }
    },
    {
      "selectors": [".ibtn-x"],
      "declarations": {
        "position": "absolute",
        "top": "var(--space-8)",
        "right": "var(--space-9)",
        "padding": "0"
      }
    },
    {
      "selectors": [".obs-x"],
      "declarations": {
        "flex-shrink": "0",
        "padding": "var(--space-3) 0 0"
      }
    },
    {
      "selectors": [".ibtn-x:hover", ".obs-x:hover"],
      "declarations": {
        "color": "var(--ink)"
      }
    },
    {
      "selectors": [".obs-toggle-list"],
      "declarations": {
        "display": "flex",
        "flex-direction": "column",
        "gap": "0"
      }
    },
    {
      "selectors": [".obs-toggle"],
      "declarations": {
        "display": "flex",
        "align-items": "flex-start",
        "gap": "var(--space-9)",
        "padding": "var(--space-7) 0",
        "border-bottom": "1px solid var(--border)",
        "cursor": "pointer",
        "user-select": "none"
      }
    },
    {
      "selectors": [".obs-toggle:last-child"],
      "declarations": {
        "border-bottom": "none"
      }
    },
    {
      "selectors": [".obs-toggle-box"],
      "declarations": {
        "width": "11px",
        "height": "11px",
        "border": "1px solid var(--border)",
        "border-radius": "var(--radius-xs)",
        "flex-shrink": "0",
        "margin-top": "var(--space-1)",
        "position": "relative",
        "transition": "all 100ms"
      }
    },
    {
      "selectors": [".obs-toggle.on .obs-toggle-box"],
      "declarations": {
        "background": "var(--ink)",
        "border-color": "var(--ink)"
      }
    },
    {
      "selectors": [".obs-toggle.on .obs-toggle-box::after"],
      "declarations": {
        "content": "\"\"",
        "position": "absolute",
        "left": "var(--space-2)",
        "top": "var(--space-5)",
        "width": "var(--space-5)",
        "height": "var(--space-3)",
        "border-left": "1.5px solid #fff",
        "border-bottom": "1.5px solid #fff",
        "transform": "rotate(-45deg) translateY(-3px)"
      }
    },
    {
      "selectors": [".obs-toggle-txt"],
      "declarations": {
        "font-size": "var(--font-size-body)",
        "line-height": "var(--line-body)",
        "color": "var(--muted)",
        "transition": "color 100ms"
      }
    },
    {
      "selectors": [".obs-toggle.on .obs-toggle-txt"],
      "declarations": {
        "color": "var(--ink)"
      }
    },
    {
      "selectors": [".obs-custom-row"],
      "declarations": {
        "display": "flex",
        "align-items": "flex-start",
        "gap": "var(--space-7)",
        "margin-bottom": "var(--space-7)"
      }
    },
    {
      "selectors": [".obs-custom-row .fi"],
      "declarations": {
        "font-size": "var(--font-size-field)"
      }
    },
    {
      "selectors": [".sheet", ".ds-sheet"],
      "declarations": {
        "width": "595px",
        "min-height": "842px",
        "background": "{components.document.sheet.background}",
        "padding": "{components.document.sheet.padding}",
        "position": "relative"
      }
    },
    {
      "selectors": [".brand", ".ds-brand"],
      "declarations": {
        "display": "flex",
        "justify-content": "space-between",
        "align-items": "center",
        "margin-bottom": "var(--space-15)"
      }
    },
    {
      "selectors": [".brand-name"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "var(--font-size-label)",
        "font-weight": "700",
        "letter-spacing": "var(--tracking-brand-doc)",
        "color": "var(--ink)",
        "text-transform": "uppercase"
      }
    },
    {
      "selectors": [".brand-slogan"],
      "declarations": {
        "font-size": "var(--font-size-tiny)",
        "color": "var(--muted)",
        "letter-spacing": "var(--tracking-wide)"
      }
    },
    {
      "selectors": [".brand-rule"],
      "declarations": {
        "height": "1px",
        "background": "var(--rule)",
        "margin-bottom": "var(--space-32)"
      }
    },
    {
      "selectors": [".title-block"],
      "declarations": {
        "margin-bottom": "var(--space-24)"
      }
    },
    {
      "selectors": [".title-bold", ".title-light", ".title-regular"],
      "declarations": {
        "font-family": "var(--font-mono)",
        "font-size": "16px",
        "color": "var(--ink)",
        "line-height": "0.95",
        "letter-spacing": "-0.03em",
        "display": "block"
      }
    },
    {
      "selectors": [".title-bold"],
      "declarations": {
        "font-weight": "700"
      }
    },
    {
      "selectors": [".title-light", ".title-regular"],
      "declarations": {
        "margin-top": "var(--space-2)"
      }
    },
    {
      "selectors": [".title-light"],
      "declarations": {
        "min-height": "32px"
      }
    },
    {
      "selectors": [".hrule", ".rule", ".ds-divider-strong"],
      "declarations": {
        "height": "1px",
        "background": "var(--ink)",
